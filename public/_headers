/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/content.js
  Cache-Control: no-cache

/
  Cache-Control: no-store
/release.json
  Cache-Control: no-store
/account-boot147.js
  Cache-Control: no-cache

/admin254*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*.woff2
  Cache-Control: public, max-age=2592000
