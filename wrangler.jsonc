{
  "name": "yalla-espanol",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-11-01",
  "services": [
    {
      "binding": "YALLA_APP",
      "service": "yalla-espanol"
    },
    {
      "binding": "YALLA_PUSH",
      "service": "yalla-espanol-reminders"
    }
  ],
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "yalla-stats",
      "database_id": "b4ec9243-e420-4f90-a54d-84ebb1c6f1af"
    }
  ]
}
